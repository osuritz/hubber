# Pinned lint tool versions: the single source of truth for CI, the Makefile
# and Scripts/install-lint-tools.sh. Plain KEY=value so sh and make can both
# read it (no quotes, no spaces). To bump, see "Pinned lint tools" in AGENTS.md.
#
# sha256 is of the release asset, from the GitHub release `digest` field.

# https://github.com/nicklockwood/SwiftFormat/releases (asset: swiftformat.zip)
# The code follows 0.64.1's default rules, including wrapIfStatementBodies
# (0.62.0) and repeatedGuard (0.64.0).
SWIFTFORMAT_VERSION=0.64.1
SWIFTFORMAT_SHA256=0e5762a848d738602c7a983b26812031e634d85e357db070968b9c805f253eff

# https://github.com/realm/SwiftLint/releases (asset: portable_swiftlint.zip)
SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
