#!/bin/sh
# Pre-push gate: run the same checks CI runs (.github/workflows/swift.yml) so a
# locally-green tree means a CI-green tree. CI runs on push to main and on PRs
# while MACOS_RUNS_ON routes it to the self-hosted Mac mini, and is manual-only
# on hosted runners otherwise. This also covers what plain `swift build` misses:
# `swift test` (which compiles the test target) and `swiftformat --lint`.
#
# Bypass for emergencies with:  git push --no-verify
# Or skip just this hook with:  SKIP_CI_HOOK=1 git push

if [ "${SKIP_CI_HOOK:-0}" = "1" ]; then
	echo "pre-push: SKIP_CI_HOOK=1 set — skipping CI checks." >&2
	exit 0
fi

echo "pre-push: running 'make ci' (build + test + lint + swiftformat --lint)…" >&2

if ! make ci; then
	echo >&2
	echo "pre-push: 'make ci' failed — push aborted." >&2
	echo "  Fix the issues above, or bypass with: git push --no-verify" >&2
	exit 1
fi

echo "pre-push: all checks passed." >&2
exit 0
