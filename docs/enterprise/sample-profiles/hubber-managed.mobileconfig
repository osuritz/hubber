<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hubber-managed.mobileconfig
  Sample MDM configuration profile for Hubber — targets domain com.hubber.app.

  BEFORE DEPLOYING:
    1. Replace all placeholder UUIDs (XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX) with
       unique UUIDs (generate with `uuidgen`).
    2. Update PayloadOrganization to your organization name.
    3. Update PayloadDisplayName / PayloadDescription to match your environment.
    4. Uncomment and edit the keys you want to force. Remove keys you do not want
       to manage (leaving a key absent lets the user configure it freely).
    5. Upload to your MDM (Jamf / Kandji / Mosyle) as a Custom Profile.

  DOMAIN:
    com.hubber.app — deliberately decoupled from the bundle id (com.osuritz.hubber)
    so this profile works for all Hubber build variants without modification.

  TIMING:
    All managed preferences are applied at Hubber launch. Changes pushed via MDM
    take effect the next time the user quits and relaunches Hubber.

  REFERENCE:
    Full key documentation: docs/enterprise/managed-preferences.md
    IT deployment guide:    docs/enterprise/it-deployment-guide.md
-->
<plist version="1.0">
<dict>

    <!-- ================================================================== -->
    <!-- Profile metadata                                                     -->
    <!-- ================================================================== -->

    <!-- Human-readable name shown in System Settings > Privacy & Security > Profiles -->
    <key>PayloadDisplayName</key>
    <string>Hubber Managed Preferences</string>

    <key>PayloadDescription</key>
    <string>Locks and presets Hubber settings for managed devices. Targeting domain com.hubber.app.</string>

    <!-- Replace with your organization name -->
    <key>PayloadOrganization</key>
    <string>Your Organization Name</string>

    <!-- Must be "Configuration" for a configuration profile -->
    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <!-- EDIT: Replace with a unique UUID (run: uuidgen) -->
    <key>PayloadUUID</key>
    <string>XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX</string>

    <!-- EDIT: Replace with a reverse-DNS identifier for this profile -->
    <key>PayloadIdentifier</key>
    <string>com.yourorg.hubber.mdm-settings</string>

    <!-- ================================================================== -->
    <!-- Payload array — one entry per managed domain                        -->
    <!-- ================================================================== -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Custom Settings payload for domain com.hubber.app -->
            <key>PayloadType</key>
            <string>com.apple.ManagedClient.preferences</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <!-- EDIT: Replace with a unique UUID (run: uuidgen) -->
            <key>PayloadUUID</key>
            <string>YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY</string>

            <!-- Must match the profile-level identifier with a .preferences suffix -->
            <key>PayloadIdentifier</key>
            <string>com.yourorg.hubber.mdm-settings.preferences</string>

            <!-- PayloadDisplayName for this sub-payload -->
            <key>PayloadDisplayName</key>
            <string>Hubber Preferences</string>

            <!-- ============================================================ -->
            <!-- Forced (managed) preferences — keyed to com.hubber.app       -->
            <!-- Only keys listed here are forced; absent keys are user-editable -->
            <!-- ============================================================ -->
            <key>PayloadEnabled</key>
            <true/>

            <key>Forced</key>
            <array>
                <dict>
                    <key>mcx_preference_settings</key>
                    <dict>

                        <!-- ------------------------------------------------ -->
                        <!-- TELEMETRY KILL-SWITCHES                           -->
                        <!-- Disable both to comply with privacy policies.     -->
                        <!-- ------------------------------------------------ -->

                        <!-- analyticsEnabled: Bool (default true)             -->
                        <!-- false = TelemetryDeck SDK never initialised       -->
                        <key>analyticsEnabled</key>
                        <false/>

                        <!-- crashReportingEnabled: Bool (default true)        -->
                        <!-- false = MetricKit subscriber never registered     -->
                        <key>crashReportingEnabled</key>
                        <false/>

                        <!-- ------------------------------------------------ -->
                        <!-- PROVIDER ACCESS CONTROL                           -->
                        <!-- Uncomment to block personal GitHub sign-in.      -->
                        <!-- ------------------------------------------------ -->

                        <!-- allowPersonalGitHub: Bool (default true)          -->
                        <!-- false = github.com sign-in is blocked; UI shows  -->
                        <!--         "restricted by your organization" message -->
                        <key>allowPersonalGitHub</key>
                        <false/>

                        <!-- providerAllowlist: Array<String> (default [])     -->
                        <!-- Non-empty = only listed hosts permitted.         -->
                        <!-- Replace with your GitHub Enterprise hostname(s). -->
                        <!-- Remove this key to allow all hosts.              -->
                        <key>providerAllowlist</key>
                        <array>
                            <string>github.yourcompany.com</string>
                        </array>

                        <!-- ------------------------------------------------ -->
                        <!-- SLO SETTINGS                                      -->
                        <!-- ------------------------------------------------ -->

                        <!-- sloWindowHours: Integer (default 24)              -->
                        <!-- Enforce a 48-hour SLO window org-wide.           -->
                        <key>sloWindowHours</key>
                        <integer>48</integer>

                        <!-- sloEnabled: Bool (default true)                   -->
                        <!-- Uncomment to force-enable or force-disable SLO.  -->
                        <!--
                        <key>sloEnabled</key>
                        <true/>
                        -->

                        <!-- sloDisplay: String (default "badge")              -->
                        <!-- Values: "badge" | "menu" | "both"                -->
                        <!--
                        <key>sloDisplay</key>
                        <string>both</string>
                        -->

                        <!-- ------------------------------------------------ -->
                        <!-- NOTIFICATIONS                                     -->
                        <!-- ------------------------------------------------ -->

                        <!-- notificationsEnabled: Bool (default true)         -->
                        <!-- false = all notifications off and toggles locked  -->
                        <key>notificationsEnabled</key>
                        <true/>

                        <!-- defaultNotificationEvents: Array<String>         -->
                        <!-- Restrict which event types trigger notifications. -->
                        <!-- When forced, per-type toggles are all locked.    -->
                        <!-- Available codes:                                  -->
                        <!--   review_requested, mentioned, assigned, push,   -->
                        <!--   resolved, closed                                -->
                        <!-- Uncomment to restrict to critical events only:   -->
                        <!--
                        <key>defaultNotificationEvents</key>
                        <array>
                            <string>review_requested</string>
                            <string>mentioned</string>
                        </array>
                        -->

                        <!-- ------------------------------------------------ -->
                        <!-- APPEARANCE / BADGE                                -->
                        <!-- ------------------------------------------------ -->

                        <!-- badgeMode: String (default "count")               -->
                        <!-- Values: "count" | "dot" | "none"                 -->
                        <!--
                        <key>badgeMode</key>
                        <string>count</string>
                        -->

                        <!-- rowDensity: String or Int (default "normal" / 1) -->
                        <!-- String: "compact" | "normal" | "spacious"        -->
                        <!-- Int:    0          | 1        | 2                 -->
                        <!--
                        <key>rowDensity</key>
                        <string>normal</string>
                        -->

                        <!-- ------------------------------------------------ -->
                        <!-- PR MODES                                          -->
                        <!-- ------------------------------------------------ -->

                        <!-- incomingMode: String (default "all")              -->
                        <!-- Values: "all" | "assigned" | "team"              -->
                        <!--
                        <key>incomingMode</key>
                        <string>all</string>
                        -->

                        <!-- unresolvedThreadMode: String (default "badge")   -->
                        <!-- Values: "badge" | "none"                         -->
                        <!--
                        <key>unresolvedThreadMode</key>
                        <string>badge</string>
                        -->

                    </dict>
                </dict>
            </array>

        </dict>
    </array>

</dict>
</plist>
